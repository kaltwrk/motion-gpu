{
	"name": "spektral-web",
	"version": "0.1.1",
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@internationalized/date": "^3.12.0",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.1.17",
		"@types/babel__standalone": "^7.1.9",
		"@types/estree": "^1.0.8",
		"@types/hast": "^3.0.4",
		"@types/node": "^25.8.0",
		"@types/unist": "^3.0.3",
		"bits-ui": "^2.18.0",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"eslint-plugin-svelte": "^3.23.0",
		"github-slugger": "^2.0.0",
		"globals": "^17.11.0",
		"mdsvex": "^0.12.6",
		"oxfmt": "catalog:",
		"rehype-slug": "^6.0.0",
		"shadcn-svelte": "1.7.0",
		"shiki": "^4.0.1",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"wrangler": "^4.125.0"
	},
	"private": true,
	"scripts": {
		"docs:changelog": "node ../../scripts/generate-changelog-docs.mjs",
		"predev": "pnpm run docs:changelog",
		"dev": "vite dev",
		"prebuild": "pnpm run docs:changelog",
		"build": "vite build",
		"preview": "vite preview",
		"preview:cf": "pnpm run build && wrangler dev",
		"preview:cf:remote": "pnpm run build && wrangler dev --remote",
		"deploy": "pnpm run build && pnpm run deploy:redirects && pnpm run deploy:app",
		"deploy:app": "wrangler deploy",
		"deploy:redirects": "wrangler deploy --config wrangler.redirects.jsonc",
		"cf-typegen": "wrangler types",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:e2e": "playwright test --config tests/playwright.config.ts",
		"test:watch": "vitest",
		"lint": "eslint . && pnpm run lint:config",
		"lint:config": "node --test ../../scripts/eslint/shared-preset.test.mjs ./scripts/lint/config-coverage.test.mjs && node ./scripts/lint/config-coverage.mjs",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"type": "module",
	"dependencies": {
		"@babel/standalone": "^7.28.5",
		"@codemirror/commands": "^6.10.2",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.11",
		"@codemirror/lang-javascript": "^6.2.4",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.12.1",
		"@codemirror/state": "^6.5.4",
		"@codemirror/view": "^6.39.15",
		"@iizukak/codemirror-lang-wgsl": "^0.3.0",
		"@lezer/highlight": "^1.2.3",
		"@replit/codemirror-lang-svelte": "^6.0.0",
		"@rollup/browser": "^4.59.0",
		"@sveltejs/acorn-typescript": "^1.0.9",
		"@takumi-rs/image-response": "1.0.0-rc.12",
		"acorn": "^8.16.0",
		"clsx": "^2.1.1",
		"esm-env": "^1.2.2",
		"magic-string": "^0.30.21",
		"resolve.exports": "^2.0.3",
		"spektral": "workspace:*",
		"tailwind-merge": "^3.5.0",
		"tarparser": "^0.0.5",
		"typegpu": "^0.10.2",
		"unplugin-typegpu": "^0.10.2",
		"yaml": "^2.9.1",
		"zimmerframe": "^1.1.4"
	}
}
