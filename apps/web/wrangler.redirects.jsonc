{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "spektral-legacy-redirects",
	"compatibility_date": "2025-09-27",
	"main": "src/legacy-redirect-worker.ts",
	"workers_dev": false,
	"observability": {
		"enabled": true
	},
	"routes": [
		{
			"pattern": "www.spektral.madebyhex.com",
			"custom_domain": true
		},
		{
			"pattern": "motion-gpu.dev",
			"custom_domain": true
		},
		{
			"pattern": "www.motion-gpu.dev",
			"custom_domain": true
		},
		{
			"pattern": "preview.motion-gpu.dev/*",
			"zone_name": "motion-gpu.dev"
		}
	]
}
